//41. First Missing Positive

class Solution {
public:
    int firstMissingPositive(vector<int>& nums) {
        int sz = nums.size();
        int i = 0;
        while(i < sz) {
            if(nums[i] > 0 &&nums[i] <= sz &&nums[i] != nums[nums[i] - 1]) {
               swap(nums[i], nums[nums[i] - 1]);
            }
            else {
                i++;
            }
        }
        for(int i = 0; i < sz; i++) {
            if(nums[i] != i + 1)
                return i + 1;
        }
        return sz + 1;
    }
};