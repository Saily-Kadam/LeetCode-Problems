// 152. Maximum Product Subarray

class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int curr_max = nums[0];
        int curr_min = nums[0];
        int best = nums[0];
        for(int i=1; i<(int)nums.size(); i++){
            int x = nums[i];
            int a = x * curr_max;
            int b = x * curr_min;

            int newMax = max(x,max(a,b));
            int newMin = min(x,min(a,b));
            curr_max = newMax;
            curr_min = newMin;
            best = max(best,curr_max);
        }
        return best;
    }
};