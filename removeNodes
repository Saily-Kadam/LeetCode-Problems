//2487. Remove Nodes From Linked List
class Solution {
public:
    ListNode* reverse(ListNode* head) {
        ListNode* prev = NULL;
        while (head) {
            ListNode* nxt = head->next;
            head->next = prev;
            prev = head;
            head = nxt;
        }
        return prev;
    }

    ListNode* removeNodes(ListNode* head) {
        head = reverse(head);

        ListNode* curr = head;
        int maxVal = INT_MIN;
        ListNode* prev = NULL;

        while (curr) {
            if (curr->val < maxVal) {
                prev->next = curr->next;
                curr = curr->next;
            } else {
                maxVal = curr->val;
                prev = curr;
                curr = curr->next;
            }
        }

        return reverse(head);
    }
};