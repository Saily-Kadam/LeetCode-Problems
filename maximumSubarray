//53. Maximum Subarray

class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int n = nums.size();
        int sum = 0;
        int globalSum = 0;
        for(int i=0; i<n; i++){
            sum += nums[i];
            globalSum = max(globalSum, sum);
            if(sum < 0)
              sum = 0;
        }
        return globalSum;
    }
};