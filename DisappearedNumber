//448. Find all Number Disappeared in an array
class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        int n = nums.size();
        unordered_map <int, int>ans;
        for(int i=0;i<n;i++){
            ans[nums[i]] = 1;
        }
        vector<int>res;
        for(int i=1;i<=n;i++){
            if(ans.find(i) == ans.end()){
                res.push_back(i);
            }
        }
        return res;
    }
};