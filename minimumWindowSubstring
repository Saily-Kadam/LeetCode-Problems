//76.Minimum Window Substring

class Solution {
public:
    string minWindow(string s, string t) {
        vector<int> freq(128, 0);
        for (char ch : t)
            freq[ch]++;
        int required = 0;
        for (int i = 0; i < 128; i++) {
            if (freq[i] > 0)
                required++;
        }
        vector<int> window(128, 0);

        int left = 0;
        int right = 0;
        int have = 0;

        int minWindow = INT_MAX;
        int start = 0;

        while (right < s.size()) {
        char ch = s[right];
            window[ch]++;

            if (freq[ch] > 0 && window[ch] == freq[ch])
                have++;

            while (have == required) {

                if (right - left + 1 < minWindow) {
                    minWindow = right - left + 1;
                    start = left;
                }

                char leftChar = s[left];
                window[leftChar]--;

                if (freq[leftChar] > 0 &&
                    window[leftChar] < freq[leftChar]) {
                    have--;
                }

                left++;
            }
        right++;
        }
        if (minWindow == INT_MAX)
            return "";

        return s.substr(start, minWindow);
    }
};