//57. Insert Interval

class Solution {
public:
    vector<vector<int>> insert(vector<vector<int>>& intervals, vector<int>& newInterval) {
        vector<vector<int>> I2;
        for (auto interval : intervals)
            I2.push_back(interval);

        I2.push_back(newInterval);

        sort(I2.begin(), I2.end(),[](const vector<int>& a, const vector<int>& b) {
                return a[0] < b[0];
            });

        vector<vector<int>> ans;
        int start = I2[0][0];
        int end = I2[0][1];

        for (int i = 1; i < I2.size(); i++) {

            if (I2[i][0] <= end) {
                end = max(end, I2[i][1]);
            }
            else {
                ans.push_back({start, end});
                start = I2[i][0];
                end = I2[i][1];
            }
        }
        ans.push_back({start, end});
        return ans;
    }
};