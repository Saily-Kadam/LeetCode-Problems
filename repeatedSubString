//459 Repeated Substring Pattern

class Solution {
public:
    bool repeatedSubstringPattern(string s) {
        int n = s.size();

        for(int i = 0; i < n / 2; i++) {
            int len = i + 1;

            if(n % len != 0)
                continue;

            int rep = n / len;

            string s1 = s.substr(0, len);
            string sz;

            for(int j = 0; j < rep; j++) {
                sz += s1;
            }

            if(sz == s)
                return true;
        }

        return false;
    }
};