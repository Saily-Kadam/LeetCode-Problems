//78 Subsets
class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>> ans;
        vector<int> curr;

        backtrack(0, curr, nums, ans);

        return ans;
    }

    void backtrack(int idx,
                   vector<int>& curr,
                   vector<int>& nums,
                   vector<vector<int>>& ans) {

        if (idx == nums.size()) {
            ans.push_back(curr);
            return;
        }

        // Include nums[idx]
        curr.push_back(nums[idx]);
        backtrack(idx + 1, curr, nums, ans);

        // Exclude nums[idx]
        curr.pop_back();
        backtrack(idx + 1, curr, nums, ans);
    }
};