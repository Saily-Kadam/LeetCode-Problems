//144. Binary Tree Preorder Traversal

class Solution {
public:
    vector<int> preorderTraversal(TreeNode* root) {
         vector<int> ans;
        traverse(root, ans);
        return ans;
    }

    void traverse(TreeNode* root, vector<int>& ans) {
        if (root == NULL)
            return;
        ans.push_back(root->val);
        traverse(root->left, ans);
        traverse(root->right, ans);
    }
};