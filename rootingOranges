//994 Rooting Oranges
class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        int rows = grid.size();
        int cols = grid[0].size();

        queue<pair<int,int>> q;
        int fresh = 0;

        for(int r = 0; r < rows; r++) {
            for(int c = 0; c < cols; c++) {
                if(grid[r][c] == 2)
                    q.push({r,c});
                else if(grid[r][c] == 1)
                    fresh++;
            }
        }

        int dr[] = {-1,1,0,0};
        int dc[] = {0,0,-1,1};

        int time = 0;

        while(!q.empty() && fresh > 0) {
            int sz = q.size();

            for(int i = 0; i < sz; i++) {
                auto [r,c] = q.front();
                q.pop();

                for(int k = 0; k < 4; k++) {
                    int nr = r + dr[k];
                    int nc = c + dc[k];

                    if(nr >= 0 && nc >= 0 &&
                       nr < rows && nc < cols &&
                       grid[nr][nc] == 1) {

                        grid[nr][nc] = 2;
                        fresh--;
                        q.push({nr,nc});
                    }
                }
            }

            time++;
        }

        return fresh == 0 ? time : -1;
    }
};