//234. Palindrome Linked List

class Solution {
public:
    bool isPalindrome(ListNode* head) {
        vector<int>arr;
        ListNode* curr = head;
        while(curr!=NULL){
            arr.push_back(curr->val);
            curr = curr->next;
        }
        int i=0, j=arr.size()-1;
        while(i<j){
            if(arr[i]!=arr[j])
            return false;
            i++,j--;
        }
        return true;
    }
};