//973. K Closest Points to Origin

class Solution {
public:
    double getDistance(vector<int>& pt) {
        return sqrt(pt[0] * pt[0] + pt[1] * pt[1]);
    }

    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<double,int>,vector<pair<double,int>>,greater<pair<double,int>>> minH;

        for(int i = 0; i < points.size(); i++) {
            minH.push({getDistance(points[i]), i});
        }

        vector<vector<int>> ans;

        while(k--) {
            int idx = minH.top().second;
            minH.pop();
            ans.push_back(points[idx]);
        }

        return ans;
    }
};