//213. House Robber II

class Solution {
public:
    int robRange(vector<int>& nums, int start, int end) {
        int prev1 = 0;
        int prev2 = 0;

        for (int i = start; i <= end; i++) {
            int ans = max(prev1, nums[i] + prev2);
            prev2 = prev1;
            prev1 = ans;
        }

        return prev1;
    }

    int rob(vector<int>& nums) {
        int n = nums.size();

        if (n == 1)
            return nums[0];

        return max(robRange(nums, 0, n - 2),robRange(nums, 1, n - 1));
    }
};